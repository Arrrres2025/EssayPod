# Copy this file to .env and fill in only the services you use.
# Never commit your real .env file or API keys.

# Volcengine Ark: summaries, condensation, paper chat, and video copy
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TEXT_MODEL=

# Volcengine podcast / speech service
# PODCAST_API_KEY and SEED_AUDIO_API_KEY are alternative credentials.
PODCAST_API_KEY=
SEED_AUDIO_API_KEY=
PODCAST_ENDPOINT=
PODCAST_APP_ID=
PODCAST_ACCESS_KEY=
PODCAST_RESOURCE_ID=
PODCAST_APP_KEY=
PODCAST_SPEAKER_A=
PODCAST_SPEAKER_B=

# Optional web search for missing background concepts
TAVILY_API_KEY=

# Optional generation tuning
PODCAST_AGENT_TEMPERATURE=0.2
PODCAST_AGENT_MAX_TOKENS=4096
PODCAST_AGENT_TIMEOUT=360

# Web UI backend used at build time
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8010

