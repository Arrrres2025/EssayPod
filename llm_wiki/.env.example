# 留空时：存在 ARK_API_KEY 则自动使用 Ark，否则使用 mock
LLM_WIKI_PROVIDER=
# Optional Wiki-only override. When empty, Ark follows EssayPod's
# ARK_TEXT_MODEL before falling back to the default flagship model.
LLM_WIKI_MODEL=
LLM_WIKI_BASE_URL=
LLM_WIKI_API_KEY=
LLM_WIKI_HOST=127.0.0.1
LLM_WIKI_PORT=8765
LLM_WIKI_MAX_UPLOAD_MB=25
LLM_WIKI_MAX_SOURCE_CHARS=120000

# 火山方舟在线推理（设置 ARK_API_KEY 后，未显式指定 provider 时会自动启用）
# LLM_WIKI_PROVIDER=ark
# ARK_API_KEY=your-ark-key
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_WIKI_MODEL=doubao-seed-2-0-pro-260215

# Ark 每次操作最多尝试两次；两次都失败且存在 DeepSeek Key 时自动回退
LLM_WIKI_ARK_MAX_ATTEMPTS=2
# Per-provider request timeout. Two Ark attempts plus DeepSeek fallback have a
# bounded worst case of roughly three times this value.
LLM_WIKI_REQUEST_TIMEOUT_SECONDS=90
# DeepSeek fallback may need longer to emit structured paper JSON, but this is
# still an absolute deadline (not an unlimited socket inactivity timeout).
LLM_WIKI_DEEPSEEK_TIMEOUT_SECONDS=180
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro

# 背景概念网页研究（Tavily Search API）
# TAVILY_API_KEY=tvly-your-key
# TAVILY_BASE_URL=https://api.tavily.com
